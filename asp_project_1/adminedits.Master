<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="adminedits.Master.cs" Inherits="asp_project_1.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>NOVA STORE</title>
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: flex;
        flex-direction: column;
        font-family: Arial, sans-serif;
        background: #f5f5f5;
        color: #1f2937;
      }

      .master-header {
        padding: 24px;
        background: #5b45f2;
        color: #ffffff;
        text-align: center;
      }
      
      .master-header h1 {
        margin: 0;
        font-size: 2rem;
        letter-spacing: 0.12em;
      }

      .master-content {
        flex: 1;
        width: min(1100px, 100%);
        margin: 0 auto;
        padding: 32px 24px;
      }

      .master-footer {
        padding: 16px 24px;
        background:#5b45f2;
        color: #ffffff;
        text-align: center;
      }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <header class="master-header">
      <h1>NOVA STORE</h1>
    </header>

    <main class="master-content">
      <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
    </main>

    <footer class="master-footer">
      &copy; 2026 NOVA STORE. All rights reserved.
    </footer>
            
        </div>
    </form>
</body>
</html>
